# --- OpenAI ---
# Reuse the same key you already use in your other repos.
OPENAI_API_KEY=sk-your-openai-key
# Optional: which model generates the code (default: gpt-5.5)
OPENAI_MODEL=gpt-5.5

# --- E2B sandbox ---
# Get a key at https://e2b.dev/dashboard.
# IMPORTANT: rotate the key you pasted into chat — treat it as compromised.
E2B_API_KEY=e2b_your-fresh-key

# --- Cost estimation (optional) ---
# Prices in USD used only to estimate the cost shown per query. Token counts
# are exact; adjust these to your actual OpenAI / E2B rates.
OPENAI_PRICE_IN=1.25       # USD per 1M input tokens
OPENAI_PRICE_OUT=10        # USD per 1M output tokens
E2B_PRICE_PER_SEC=0.00014  # USD per sandbox-second

# --- Server ---
# Local dev port. Render injects PORT automatically, so leave this alone in prod.
PORT=3000
