# --- AI:ssociate knowledge base (primary source for every legal question) ---
# POST https://app.aissociate.at/api/public/v1/chat/ask (see pypi.org/project/aissociate).
# A TEST-ONLY fallback key is hardcoded in server.js; set this in production.
AISSOCIATE_API_KEY=ck:your-key
AISSOCIATE_BASE_URL=https://app.aissociate.at
AISSOCIATE_PRICE_PER_CALL=0

# --- Azure OpenAI (EU deployment) ---
# When AZURE_OPENAI_API_KEY is set, EVERY model call goes to this resource and one
# deployment does everything (planning, answers, documents, DD, code generation);
# the OPENAI_MODEL_* variables below are then ignored. The difficulty routing stays
# (knowledge base for hard legal questions, more reasoning effort for hard tasks).
# Optional per role: AZURE_OPENAI_MODEL_MAIN / AZURE_OPENAI_MODEL_FAST / AZURE_OPENAI_MODEL_CODE.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://aissociate-evaluation-azure-openai-ressource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-6.1-terra
# The due diligence runs on its own deployment (default gpt-6.1-sol, region global).
AZURE_OPENAI_DD_DEPLOYMENT=gpt-6.1-sol
# The SPA draft from a due diligence runs on its own model (default gpt-6.1-astra;
# without Azure: OPENAI_MODEL_SPA, default gpt-6-astra).
AZURE_OPENAI_SPA_DEPLOYMENT=gpt-6.1-astra
# Price estimate for the deployment (USD per 1M tokens), e.g.
# OPENAI_PRICES_JSON={"gpt-6.1-terra":{"in":2,"cached":0.2,"out":10}}

# --- OpenAI (only without AZURE_OPENAI_API_KEY) ---
OPENAI_API_KEY=sk-your-openai-key
# The fast model handles everything easy (planning, compact questions, easy legal
# questions with web search, easy document tasks, DD document analysis); the main
# model takes hard non-legal tasks and the DD synthesis; hard legal questions go to
# the AI:ssociate knowledge base in one request. OPENAI_MODEL_CODE pins the code
# model; empty = follows the task's difficulty.
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_MAIN=gpt-6-sol
OPENAI_MODEL_CODE=
# Questions per request to the knowledge base (Luna splits only real multi-part questions)
KB_MAX_QUESTIONS=3
# The knowledge base never sees our documents: questions about a document carry its wording.
# Short documents go in whole, otherwise the fast model picks verbatim passages (checked
# against the text) from up to KB_CONTEXT_SOURCE_CHARS characters.
KB_CONTEXT_CHARS=8000
KB_CONTEXT_SOURCE_CHARS=240000
# Documents of a conversation stay available (text, in memory) for follow-up questions
SESSION_DOCS_TTL_MS=21600000
SESSION_DOCS_MAX_CHARS=2000000
# Local folders: the browser runs the file tools (search/read/attach) and answers within this time
CLIENT_TOOL_TIMEOUT_MS=120000
# Optional second pass: Sol reviews the knowledge-base answer with ≤ 3 web searches (off = answer shown as is)
REVIEW_ANSWERS=off
# Reasoning effort (low | medium | high)
OPENAI_EFFORT_MAIN=medium
OPENAI_EFFORT_PLAN=low
OPENAI_EFFORT_CODE=medium
# Hard budgets per question (summed over all model calls of that question)
MAX_INPUT_TOKENS=1000000
MAX_OUTPUT_TOKENS=100000
MAX_OUTPUT_PER_CALL=16000
# Step limits
MAX_WEB_SEARCHES=3
DOC_MAX_STEPS=8
# Hosted web search (fallback after the knowledge base). "off" disables.
OPENAI_WEB_SEARCH=on
OPENAI_WEB_SEARCH_TOOL=web_search

# --- Accounts ---
# On by default: every user signs in and sees only their own Akten, Skills and
# conversations. The first account becomes administrator and creates the others
# (Settings → Benutzer). AUTH=off only for local development without accounts.
AUTH=on
# Signs the session cookies; without it a random key is kept in DATA_DIR/.auth-secret
AUTH_SECRET=
# Self-registration for these e-mail domains (comma-separated), or AUTH_SIGNUP=open
AUTH_ALLOWED_DOMAINS=
AUTH_SIGNUP=

# --- Akten & Due Diligence ---
# Storage for accounts, matters, skills and conversations. On Render mount a
# persistent disk at /data (picked up automatically, or set DATA_DIR=/data);
# without one the data lives until the next deploy.
DATA_DIR=./data
# Per-document routing in the DD works like the assistant: a triage on the fast
# model decides the difficulty of each document; easy documents are analysed on
# the fast model (OPENAI_MODEL_EXTRACT, defaults to it), hard ones on the main
# model; easy legal questions of a document go to the fast model with web search,
# hard ones to the knowledge base in ONE request per document.
OPENAI_MODEL_EXTRACT=gpt-6-luna
OPENAI_EFFORT_DD=medium
DD_MAX_DOCS=300
DD_MAX_DOC_BYTES=31457280
# Concurrent long-running analyses per instance
DD_MAX_CONCURRENT=2
# Model calls of one due diligence running side by side (all sections of all documents)
DD_CONCURRENCY=24
# Hard limit per due diligence (all runs together), not adjustable in the UI
DD_MAX_INPUT_TOKENS=100000000
DD_MAX_OUTPUT_TOKENS=10000000
# Knowledge-base requests per run (only very hard questions of red findings; the rest: web search in the RIS)
DD_MAX_KB_CALLS=5
# OCR of scanned PDFs and images by the model (pages per call, page cap); OCR=off disables it
OCR_PAGES_PER_CALL=10
OCR_MAX_PAGES=400
# Attachments up to this many characters go to Sol as full text (saves a read step)
INLINE_DOC_CHARS=80000
# Retries for transient model errors (429/5xx/network) per call
MODEL_RETRIES=3

# --- Microsoft 365 (OneDrive / SharePoint via Microsoft Graph, optional) ---
# Entra admin center → App registrations → New registration:
#   platform "Web", redirect URI https://<your-host>/api/ms/callback
#   API permissions (delegated): User.Read, Files.ReadWrite.All, Sites.ReadWrite.All, offline_access
#   Certificates & secrets → client secret. A "Web" registration is a confidential
#   client, so MS_CLIENT_SECRET is REQUIRED (Entra rejects the code redemption
#   without it, AADSTS7000218).
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" (any Microsoft account), "organizations", or your tenant id
MS_TENANT=common
# Optional; derived from the request host when empty
MS_REDIRECT_URI=
# Secret for the encrypted login cookie (defaults to the client secret; without
# either, a random per-process key is used and logins end at the next restart)
MS_COOKIE_SECRET=
# Optional: only these tenant ids may sign in (JSON array or comma-separated);
# one id becomes the authority instead of MS_TENANT. Empty = any tenant.
MS_ALLOWED_TENANTS=
# The MICROSOFT_* names of other deployments work too (MS_* wins):
#   MICROSOFT_CLIENT_ID → MS_CLIENT_ID, MICROSOFT_CLIENT_SECRET → MS_CLIENT_SECRET,
#   MICROSOFT_TOKEN_ENCRYPTION_KEY → MS_COOKIE_SECRET, MICROSOFT_ALLOWED_TENANTS → MS_ALLOWED_TENANTS,
#   MICROSOFT_REDIRECT_URI → MS_REDIRECT_URI, MICROSOFT_ENABLED=false switches the integration off.
# A localhost redirect URI is replaced by the deployed host (path kept; both
# /api/ms/callback and /api/integrations/microsoft/callback are served).
# GET /api/health shows the redirect URI to register in Entra (msRedirectUri).

# --- E2B sandbox (only used by the file tool: create/edit .docx/.xlsx/.pdf) ---
# IMPORTANT: rotate any key that was ever pasted into a chat.
E2B_API_KEY=e2b_your-fresh-key

# --- Cost estimation (optional) ---
# Real GPT-6 API rates are built in (Luna $0.10/$0.01/$0.50, Sol $2/$0.20/$10 per 1M
# input/cached/output tokens). Override per model id if needed:
# OPENAI_PRICES_JSON={"gpt-6-sol":{"in":2,"cached":0.2,"out":10}}
OPENAI_WEB_SEARCH_PRICE_PER_CALL=0.01
E2B_PRICE_PER_SEC=0.00014

# --- Server ---
PORT=3000
# Only for development, tests and the explainer video (tools/video):
# SANDBOX=local runs generated code on THIS machine instead of E2B – no isolation,
# never on a server with client data (LOCAL_SANDBOX_PYTHON: interpreter with python-docx/openpyxl)
# SANDBOX=local
# a mock RIS OGD API
# RIS_BASE_URL=http://127.0.0.1:3953
