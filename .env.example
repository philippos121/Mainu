# --- OpenAI ---
# Reuse the same key you already use in your other repos.
OPENAI_API_KEY=sk-your-openai-key
# Optional: which model generates the code (default: gpt-5.5)
OPENAI_MODEL=gpt-5.5

# --- E2B sandbox ---
# Get a key at https://e2b.dev/dashboard.
# IMPORTANT: rotate the key you pasted into chat — treat it as compromised.
E2B_API_KEY=e2b_your-fresh-key

# --- Cost estimation (optional) ---
# Defaults are the real OpenAI GPT-5.5 API rates. Override if your model/rates
# differ. Token counts are exact (from the API usage field), incl. cached input.
OPENAI_PRICE_IN=5          # USD per 1M input tokens (GPT-5.5)
OPENAI_PRICE_CACHED=0.5    # USD per 1M cached input tokens (GPT-5.5)
OPENAI_PRICE_OUT=30        # USD per 1M output tokens (GPT-5.5)
E2B_PRICE_PER_SEC=0.00014  # USD per sandbox-second (adjust to your E2B plan)

# --- Server ---
# Local dev port. Render injects PORT automatically, so leave this alone in prod.
PORT=3000
