# ============================================================
# OpenClaw Setup — Umgebungsvariablen
# Kopiere diese Datei zu .env und fülle sie aus:
#   cp .env.example .env
# ============================================================

# --- LLM Provider (OpenAI / GPT-4o) ---
OPENAI_API_KEY=sk-HIER-DEINEN-KEY

# --- Deine E-Mail (Empfänger aller Entwürfe) ---
MY_EMAIL=du@deinekanzlei.at

# --- IMAP (Outlook-Postfach, das die Weiterleitungen empfängt) ---
IMAP_SERVER=outlook.office365.com
IMAP_USER=weiterleitung@deinekanzlei.at
IMAP_PASSWORD=HIER-DEIN-PASSWORT
IMAP_FOLDER=INBOX

# --- SMTP (zum Senden der Entwürfe an dich) ---
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USER=weiterleitung@deinekanzlei.at
SMTP_PASSWORD=HIER-DEIN-PASSWORT

# --- Teams-Integration (optional) ---
# Incoming: Power Automate sendet an http://DEIN-LAPTOP:8080/webhook/teams
# Outgoing: Power Automate Incoming-Webhook-URL für deinen Kanal
TEAMS_OUTGOING_WEBHOOK=https://deinefirma.webhook.office.com/webhookb2/...

# --- Polling-Intervall (Sekunden) ---
POLL_INTERVAL_SECONDS=30
