{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": "{{model}}",
      "provider": "{{provider}}"
    }
  },
  "channels": {
    {{#whatsapp}}
    "whatsapp": {
      "enabled": true,
      "allowFrom": [{{whatsapp_numbers}}]
    },
    {{/whatsapp}}
    {{#telegram}}
    "telegram": {
      "enabled": true
    },
    {{/telegram}}
    {{#discord}}
    "discord": {
      "enabled": true
    },
    {{/discord}}
    "web": {
      "enabled": true
    }
  },
  "skills": {
    "install": {
      "nodeManager": "npm"
    },
    "entries": {}
  }
}
